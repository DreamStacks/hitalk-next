{
  "name": "hitalk-next",
  "version": "0.1.0",
  "private": true,
  "description": "可自托管的轻量评论系统",
  "keywords": [],
  "license": "MIT",
  "author": "ihoey <mail@ihoey.com> (https://blog.ihoey.com/)",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:setup && concurrently --kill-others --names worker,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:setup": "node scripts/setup-dev.mjs",
    "dev:server": "pnpm --filter @hitalk/server dev --local --ip 127.0.0.1 --port 8787",
    "dev:web": "vite",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "typecheck": "pnpm --filter @hitalk/server typecheck && pnpm --filter @hitalk/sdk typecheck && tsc -p tsconfig.dev.json && tsc -p tsconfig.tools.json",
    "build": "pnpm --filter @hitalk/sdk build",
    "build:web": "vite build",
    "preview:web": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "pnpm build && vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage",
    "db:verify-backup": "node scripts/verify-backup.mjs",
    "test:worker": "vitest run --config vitest.integration.config.ts",
    "test:watch": "pnpm build && vitest",
    "test:coverage": "pnpm build && vitest run --coverage",
    "db:seed": "pnpm dev:setup && pnpm --filter @hitalk/server db:seed"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.11",
    "@types/node": "^22.20.3",
    "@vitest/coverage-istanbul": "4.1.11",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
