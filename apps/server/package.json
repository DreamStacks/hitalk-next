{
  "name": "@hitalk/server",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:init": "wrangler d1 execute hitalk --local --file=./src/schema.sql",
    "db:migrate": "wrangler d1 execute hitalk --file=./src/schema.sql"
  },
  "dependencies": {
    "@hitalk/shared": "workspace:*",
    "hono": "^4.11.5",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.0.0",
    "nanoid": "^5.1.6",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260127.0",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-emoji": "^3.0.1",
    "wrangler": "^4.4.0"
  }
}
