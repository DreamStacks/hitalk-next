{
  "name": "@hitalk/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:init": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env production",
    "db:backup:local": "wrangler d1 export DB --local",
    "db:backup:remote": "wrangler d1 export DB --remote --env production",
    "build": "wrangler deploy --env production --dry-run --outdir dist",
    "db:seed": "wrangler d1 execute DB --local --file ../../examples/playground/seed.sql"
  },
  "dependencies": {
    "@hitalk/shared": "workspace:*",
    "bowser": "^2.14.1",
    "hono": "^4.13.8",
    "markdown-it": "^15.0.2",
    "markdown-it-emoji": "^3.1.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "wrangler": "^4.133.0"
  }
}
