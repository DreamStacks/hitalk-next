{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hitalk-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hitalk",
      "database_id": "a4cdba1f-2f54-4add-8125-49bd14d44f0c",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "production": {
      "name": "hitalk-server",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hitalk-next",
          "database_id": "782bd54d-2e2d-4fff-9778-0e02a7d0655f",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
